{
  "entities": {
    "Call": {
      "title": "Call",
      "description": "Represents a WebRTC call session for signaling.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "callerId": { "type": "string" },
        "receiverId": { "type": "string" },
        "status": { "type": "string", "enum": ["initiating", "ringing", "active", "ended"] },
        "offer": { "type": "object" },
        "answer": { "type": "object" },
        "callerCandidates": { "type": "array" },
        "receiverCandidates": { "type": "array" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "callerId", "receiverId", "status", "timestamp"]
    },
    "GroupChat": {
      "title": "Group Chat",
      "description": "A group chat with a voice channel.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "memberIds": { "type": "array" },
        "voiceChannel": {
          "type": "object",
          "properties": {
            "active": { "type": "boolean" },
            "participants": { "type": "array" }
          }
        }
      }
    },
    "UserStatus": {
      "title": "User Status",
      "description": "Presence and status of a user.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "status": { "type": "string" },
        "lastSeen": { "type": "number" }
      }
    }
  },
  "firestore": {
    "calls/{callId}": {
      "schema": "Call",
      "description": "WebRTC signaling data for calls."
    },
    "group_chats/{groupId}": {
      "schema": "GroupChat",
      "description": "Group chat data and voice state."
    },
    "user_statuses/{userId}": {
      "schema": "UserStatus",
      "description": "User presence information."
    }
  }
}
