rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper to check staff or owner role from request claims or document
    function isStaffOrAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'owner' || 
        request.auth.token.role == 'staff' ||
        request.auth.token.admin == true ||
        request.auth.token.email == 'zaellacruze1@gmail.com'
      );
    }

    // Users collection
    match /users/{userId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isStaffOrAdmin() || isOwner(userId);
    }

    // Videos collection (posts, shorts, photo posts)
    match /videos/{videoId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Stories collection (24-hour ephemeral posts)
    match /stories/{storyId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Messages collection
    match /messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Reports collection
    match /reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Appeals collection
    match /appeals/{appealId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if true;
    }

    // Audit logs collection
    match /auditLogs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if isStaffOrAdmin();
    }

    // FAQ Categories (Discord-like forum)
    match /faq_categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // FAQ Posts (Discord-like forum posts)
    match /faq_posts/{postId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Forum Edit Requests
    match /forum_edit_requests/{requestId} {
      allow read, write: if true;
    }

    // App Settings (Global configuration)
    match /app_settings/{settingId} {
      allow read: if true;
      allow write: if isStaffOrAdmin() || !isAuthenticated(); // Support custom login for owner while testing
    }

    // Calls collection (WebRTC signaling)
    match /calls/{callId} {
      allow read, write: if true;
    }

    // Group Chats
    match /group_chats/{groupId} {
      allow read, write: if true;
    }

    // User Statuses
    match /user_statuses/{statusId} {
      allow read, write: if true;
    }

    // Game Data
    match /game_data/{gameDataId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // Watch Parties
    match /watch_parties/{partyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.hostId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.hostId == request.auth.uid || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants']))
      );
      allow delete: if isAuthenticated() && resource.data.hostId == request.auth.uid;
    }
  }
}
